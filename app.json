{
  "expo": {
    "name": "NutriSchool",
    "slug": "4nschool-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "fournschool",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E2B58"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fournschool.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1E2B58"
      },
      "package": "com.fournschool.mobile"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-build-properties",
        {
          "android": {
            "extraGradleProps": {
              "REACT_NATIVE_NODE_MODULES_DIR": "../../node_modules"
            },
            "packagingOptions": {
              "pickFirst": [
                "**/libhermes.so",
                "**/libc++_shared.so",
                "**/libworklets.so",
                "**/libreanimated.so"
              ]
            }
          }
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {
        "origin": false,
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "287a33be-7c9f-4d6f-8d09-d24a5125cf53"
      }
    },
    "owner": "riclayton"
  }
}